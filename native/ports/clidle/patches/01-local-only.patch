+// Tuikio: the game's history in a small JSON file instead of SQLite. The pure-Go SQLite driver
+// (modernc.org/sqlite) added about 4 MB to every binary for three queries; these are the same
+// three, with the same results: record a game, record a guess, and the total score.
+
+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"io/fs"
+	"os"
+)
+
+type fileGame struct {
+	Answer  string   `json:"answer"`
+	Guesses []string `json:"guesses"`
+}
+
+type Queries struct {
+	path  string
+	games []fileGame
+}
+
+// Open reads the history at path (a missing file is an empty history).
+func Open(path string) (*Queries, error) {
+	q := &Queries{path: path}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, fs.ErrNotExist) {
+		return q, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if err := json.Unmarshal(data, &q.games); err != nil {
+		return nil, err
+	}
+	return q, nil
+}
+
+func (q *Queries) save() error {
+	data, err := json.Marshal(q.games)
+	if err != nil {
+		return err
+	}
+	tmp := q.path + ".tmp"
+	if err := os.WriteFile(tmp, data, 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, q.path)
+}
+
+func (q *Queries) CreateGame(ctx context.Context, answer sql.NullString) (Game, error) {
+	q.games = append(q.games, fileGame{Answer: answer.String})
+	return Game{ID: int64(len(q.games)), Answer: answer}, q.save()
+}
+
+type CreateGuessParams struct {
+	GameID sql.NullInt64
+	Guess  sql.NullString
+}
+
+func (q *Queries) CreateGuess(ctx context.Context, arg CreateGuessParams) (Guess, error) {
+	i := int(arg.GameID.Int64) - 1
+	if i < 0 || i >= len(q.games) {
+		return Guess{}, errors.New("no such game")
+	}
+	q.games[i].Guesses = append(q.games[i].Guesses, arg.Guess.String)
+	return Guess{GameID: arg.GameID, Guess: arg.Guess}, q.save()
+}
+
+// GetTotalScore: 10 * (11 - guesses) for every game that was won, summed.
+func (q *Queries) GetTotalScore(ctx context.Context) (sql.NullFloat64, error) {
+	total, won := 0, false
+	for _, g := range q.games {
+		for _, guess := range g.Guesses {
+			if guess == g.Answer {
+				total += 10 * (11 - len(g.Guesses))
+				won = true
+				break
+			}
+		}
+	}
+	return sql.NullFloat64{Float64: float64(total), Valid: won}, nil
+}

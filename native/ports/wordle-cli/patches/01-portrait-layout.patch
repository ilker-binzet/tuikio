-		lipgloss.NewStyle().Padding(0, 2).Render("ctrl+c - quit"),
-		lipgloss.NewStyle().Padding(0, 2).Render("enter - submit word"),
+	return lipgloss.JoinVertical(
+		lipgloss.Center,

{
  "schema_version": 1,
  "profile_id": "shellshock.v1",
  "title": "Ship (arrows), fire and autofire",
  "help": "The pad flies the ship; Fire shoots (Space). Auto toggles autofire, Pause pauses, Quit returns to the title.",
  "orientation": "landscape",
  "actions": [
    {
      "id": "up",
      "label": "Up",
      "icon": "arrow_up",
      "output": {
        "key": "UP"
      },
      "repeat": {
        "delay_ms": 200,
        "interval_ms": 70
      }
    },
    {
      "id": "down",
      "label": "Down",
      "icon": "arrow_down",
      "output": {
        "key": "DOWN"
      },
      "repeat": {
        "delay_ms": 200,
        "interval_ms": 70
      }
    },
    {
      "id": "left",
      "label": "Left",
      "icon": "arrow_left",
      "output": {
        "key": "LEFT"
      },
      "repeat": {
        "delay_ms": 200,
        "interval_ms": 70
      }
    },
    {
      "id": "right",
      "label": "Right",
      "icon": "arrow_right",
      "output": {
        "key": "RIGHT"
      },
      "repeat": {
        "delay_ms": 200,
        "interval_ms": 70
      }
    },
    {
      "id": "fire",
      "label": "Fire",
      "output": {
        "text": " "
      }
    },
    {
      "id": "auto",
      "label": "Auto",
      "output": {
        "text": "z"
      }
    },
    {
      "id": "pause",
      "label": "Pause",
      "output": {
        "text": "p"
      }
    },
    {
      "id": "quit",
      "label": "Quit",
      "icon": "close",
      "output": {
        "text": "q"
      },
      "confirm": true
    }
  ],
  "layout": {
    "portrait": [
      {
        "type": "dpad4",
        "anchor": "bottom_start",
        "size": 184,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 96,
        "bind": {
          "press": "fire"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 60,
        "bind": {
          "press": "auto"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "quit"
        }
      },
      {
        "type": "button",
        "anchor": "top_start",
        "size": 52,
        "bind": {
          "press": "pause"
        }
      }
    ],
    "landscape": [
      {
        "type": "dpad4",
        "anchor": "center_start",
        "size": 176,
        "bind": {
          "up": "up",
          "down": "down",
          "left": "left",
          "right": "right"
        }
      },
      {
        "type": "button",
        "anchor": "center_end",
        "size": 96,
        "bind": {
          "press": "fire"
        },
        "style": "primary"
      },
      {
        "type": "button",
        "anchor": "bottom_end",
        "size": 60,
        "bind": {
          "press": "auto"
        }
      },
      {
        "type": "button",
        "anchor": "top_end",
        "size": 52,
        "bind": {
          "press": "quit"
        }
      },
      {
        "type": "button",
        "anchor": "top_start",
        "size": 52,
        "bind": {
          "press": "pause"
        }
      }
    ]
  },
  "pointer": "none",
  "keyboard": true
}

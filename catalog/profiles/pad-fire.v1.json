{
  "schema_version": 1,
  "profile_id": "pad-fire.v1",
  "title": "Pad and fire",
  "help": "Move with the pad and act with the big button (Space: fire, jump, pump...). OK is Enter, which starts a new game after a game over.",
  "orientation": "any",
  "actions": [
    {"id": "up", "label": "Up", "icon": "arrow_up", "output": {"key": "UP"}, "repeat": {"delay_ms": 150, "interval_ms": 45}},
    {"id": "down", "label": "Down", "icon": "arrow_down", "output": {"key": "DOWN"}, "repeat": {"delay_ms": 150, "interval_ms": 45}},
    {"id": "left", "label": "Left", "icon": "arrow_left", "output": {"key": "LEFT"}, "repeat": {"delay_ms": 150, "interval_ms": 45}},
    {"id": "right", "label": "Right", "icon": "arrow_right", "output": {"key": "RIGHT"}, "repeat": {"delay_ms": 150, "interval_ms": 45}},
    {"id": "fire", "label": "Fire", "icon": "spark", "output": {"text": " "}, "repeat": {"delay_ms": 300, "interval_ms": 150}, "haptic": "click"},
    {"id": "ok", "label": "OK", "icon": "check", "output": {"key": "ENTER"}},
    {"id": "quit", "label": "Quit", "icon": "close", "output": {"text": "q"}, "confirm": true}
  ],
  "layout": {
    "portrait": [
      {"type": "dpad4", "anchor": "bottom_start", "size": 184, "bind": {"up": "up", "down": "down", "left": "left", "right": "right"}},
      {"type": "button", "anchor": "bottom_end", "size": 96, "bind": {"press": "fire"}, "style": "primary"},
      {"type": "button", "anchor": "bottom_end", "offset": [0, -108], "size": 60, "bind": {"press": "ok"}},
      {"type": "button", "anchor": "top_end", "size": 52, "bind": {"press": "quit"}}
    ],
    "landscape": [
      {"type": "dpad4", "anchor": "center_start", "size": 176, "bind": {"up": "up", "down": "down", "left": "left", "right": "right"}},
      {"type": "button", "anchor": "center_end", "size": 92, "bind": {"press": "fire"}, "style": "primary"},
      {"type": "button", "anchor": "bottom_end", "size": 56, "bind": {"press": "ok"}},
      {"type": "button", "anchor": "top_end", "size": 52, "bind": {"press": "quit"}}
    ]
  },
  "pointer": "none",
  "keyboard": true
}
